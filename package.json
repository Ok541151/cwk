{
  "name": "dsh-agent-picker",
  "version": "0.5.0",
  "description": "Agent 模式选择器：像推理档位那样选定一个外部 Agent CLI（Claude Code / Codex / Qwen / Gemini / Aider / Goose / Hermes / OpenClaw / Ollama…）作为默认执行体。Agent 目录是数据驱动的：加一个新 Agent 只需加一条数据，不必改代码。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ok541151/cwk.git"
  },
  "homepage": "https://github.com/Ok541151/cwk#readme",
  "bugs": {
    "url": "https://github.com/Ok541151/cwk/issues"
  },
  "files": [
    "CHANGELOG.md",
    "lib",
    "agents.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "agent-picker",
    "cli",
    "claude-code",
    "codex",
    "qwen",
    "gemini",
    "ollama"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
